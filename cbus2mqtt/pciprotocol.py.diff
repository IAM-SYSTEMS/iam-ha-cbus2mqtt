+    async def _tx_loop(self):
+        """Send confirmed C-Bus packets one at a time; wait/retry on confirm."""
+        while True:
+            try:
+                cmd, conf_code = await self._tx_queue.get()
+            except CancelledError:
+                break
+
+            transport = self._transport
+            if transport is None:
+                continue
+
+            confirmed = False
+            loop = get_running_loop()
+            for attempt in range(2):
+                fut = loop.create_future()
+                self._in_flight_code = conf_code
+                self._in_flight_future = fut
+                logger.debug(
+                    f'tx-queue attempt {attempt} code={conf_code!r}: {cmd!r}')
+                try:
+                    transport.write(cmd)
+                    ok = await wait_for(fut, 0.35)
+                except CancelledError:
+                    self._in_flight_code = None
+                    self._in_flight_future = None
+                    raise
+                except Exception as exc:
+                    # TimeoutError on 3.10 is asyncio.TimeoutError
+                    logger.warning(
+                        'C-Bus confirm wait failed '
+                        f'(code={conf_code!r} attempt={attempt}): {exc!r}')
+                    ok = False
+                finally:
+                    self._in_flight_code = None
+                    self._in_flight_future = None
+
+                if ok:
+                    confirmed = True
+                    break
+                await sleep(0.05)
+
+            if not confirmed:
+                logger.error(
+                    f'C-Bus command dropped after retry (code={conf_code!r})')
